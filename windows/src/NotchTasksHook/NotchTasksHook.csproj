<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>NotchTasksHook</RootNamespace>
    <AssemblyName>NotchTasksHook</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!-- Native AOT is opt-in (-p:UseAot=true) because it needs the MSVC linker. -->
  <PropertyGroup Condition="'$(UseAot)'=='true'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <!-- Otherwise a Release publish is ReadyToRun (still needs a RuntimeIdentifier, e.g. -r win-x64). -->
  <PropertyGroup Condition="'$(UseAot)'!='true' And '$(Configuration)'=='Release'">
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NotchTasks.Core\NotchTasks.Core.csproj" />
  </ItemGroup>

</Project>
