<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Framework-dependent, not AOT: System.Management (WMI) is allowed here, and in the app only for the brightness feed (Levels). Never Core. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NotchTasksSensors</RootNamespace>
    <AssemblyName>NotchTasksSensors</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Runs as SYSTEM from a logon task: no startup hook from the environment (DOTNET_STARTUP_HOOKS) may load code into it. -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NotchTasks.Core\NotchTasks.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The helper's pure parts (the sensor choice, the PawnIO step) are tested in the helper's test project. -->
    <InternalsVisibleTo Include="NotchTasksSensors.Tests" />
  </ItemGroup>

  <!-- WMI (root\WMI, the thermal zones). The helper and the app (its brightness feed) reference it: never Core. -->
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>

  <!-- The CPU and GPU temperatures (MPL-2.0, see installer\THIRD-PARTY-NOTICES.txt). It reads them through the PawnIO driver. -->
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- The failure report in the Application event log (the helper is elevated, so it may create the source). Same 10.0.2 as System.Management. -->
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.2" />
  </ItemGroup>

</Project>
