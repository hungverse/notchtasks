<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Framework-dependent, not AOT: System.Management (WMI) is allowed here, and in the app only for the brightness feed (Levels). Never Core. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NotchTasksSensors</RootNamespace>
    <AssemblyName>NotchTasksSensors</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Runs as SYSTEM from a logon task: no startup hook from the environment (DOTNET_STARTUP_HOOKS) may load code into it. -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NotchTasks.Core\NotchTasks.Core.csproj" />
  </ItemGroup>

  <!-- WMI (root\WMI, the thermal zones). The helper and the app (its brightness feed) reference it: never Core. -->
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
