<UserControl x:Class="NotchTasks.Pill.AskCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:fi="clr-namespace:NotchTasks"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="AskStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <!-- Mac AskCard: an orange card with the agent's header, its body (an approval or the questions) and a footer. -->
  <Border CornerRadius="14" Padding="11" BorderThickness="1"
          Background="#21FF9F0A" BorderBrush="#59FF9F0A">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <fi:FluentGlyph x:Name="Glyph" Width="28" Height="28" Size="14" VerticalAlignment="Center" Foreground="{StaticResource AskOrange}" />
        <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="SessionText" FontSize="11" Foreground="#8E8E93" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock x:Name="WaitingText" Grid.Column="2" VerticalAlignment="Center" FontSize="10" FontWeight="Medium"
                   Foreground="{StaticResource AskOrange}" />
      </Grid>
      <StackPanel x:Name="BodyPanel" />
      <Grid Margin="0,9,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Button Focusable="False" x:Name="LinkButton" Grid.Column="0" Style="{StaticResource LinkChoice}" VerticalAlignment="Center">
          <TextBlock x:Name="LinkText" TextDecorations="Underline" />
        </Button>
        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <Button Focusable="False" x:Name="SendButton" Style="{StaticResource PrimaryChoice}" Visibility="Collapsed" />
          <Button Focusable="False" x:Name="DenyButton" Style="{StaticResource ChoiceButton}" Margin="0,0,6,0" Visibility="Collapsed" />
          <Button Focusable="False" x:Name="AllowButton" Style="{StaticResource PrimaryChoice}" Visibility="Collapsed" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
