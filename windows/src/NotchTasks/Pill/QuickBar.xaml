<UserControl x:Class="NotchTasks.Pill.QuickBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NotchTasks.ControlPanel"
             Height="26" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PillStyles.xaml" />
        <ResourceDictionary Source="AskStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <!-- The timer's glyph and quick-start pills, at the left: shown while the timer module is on and no timer runs. -->
    <StackPanel x:Name="TimerBar" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
      <!-- Grey, as the Mac's quick bar (.foregroundStyle(.gray)); the card and the chip take the timer's tint. -->
      <TextBlock x:Name="TimerGlyph" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12"
                 Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,8,0" />
      <StackPanel x:Name="TimerPills" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Focusable="False" x:Name="Timer5" Tag="5" Style="{StaticResource ChoiceButton}" Padding="9,0" Margin="0,0,4,0" Content="5&#x2032;" />
        <Button Focusable="False" x:Name="Timer15" Tag="15" Style="{StaticResource ChoiceButton}" Padding="9,0" Margin="0,0,4,0" Content="15&#x2032;" />
        <Button Focusable="False" x:Name="Timer25" Tag="25" Style="{StaticResource ChoiceButton}" Padding="9,0" Margin="0,0,4,0" Content="25&#x2032;" />
        <Button Focusable="False" x:Name="Timer45" Tag="45" Style="{StaticResource ChoiceButton}" Padding="9,0" Content="45&#x2032;" />
      </StackPanel>
    </StackPanel>
    <!-- The Control Panel (gear) and Quit (power), at the right, as on the Mac. -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Focusable="False" x:Name="ControlPanelButton" Style="{StaticResource FooterButton}" Margin="0,0,6,0"
              Content="&#xE713;" ToolTip="{l:L Control Panel}" />
      <Button Focusable="False" x:Name="QuitButton" Style="{StaticResource FooterButton}"
              Content="&#xE7E8;" ToolTip="{l:L Quit}" />
    </StackPanel>
  </Grid>
</UserControl>
