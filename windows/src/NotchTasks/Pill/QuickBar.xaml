<UserControl x:Class="NotchTasks.Pill.QuickBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NotchTasks.ControlPanel"
             Height="26" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PillStyles.xaml" />
        <ResourceDictionary Source="AskStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- The Mirror pill: a grey-white capsule, 22 px high (Mac Mirror label: white semibold 11 on a 12% white fill). -->
      <Style x:Key="MirrorChip" TargetType="Button" BasedOn="{StaticResource ChoiceButton}">
        <Setter Property="Background" Value="#1FFFFFFF" />
        <Setter Property="Height" Value="22" />
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <!-- The timer's glyph and quick-start pills, then the camera mirror's Mirror pill, at the left. The timer's bar shows while the
         timer module is on and no timer runs; the Mirror pill shows while the mirror module is on and the mirror is closed. -->
    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
      <StackPanel x:Name="TimerBar" Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Grey, as the Mac's quick bar (.foregroundStyle(.gray)); the card and the chip take the timer's tint. -->
        <TextBlock x:Name="TimerGlyph" FontFamily="{StaticResource FluentRegular}" FontSize="12"
                   Foreground="#8E8E93" VerticalAlignment="Center" Margin="0,0,8,0" />
        <StackPanel x:Name="TimerPills" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Focusable="False" x:Name="Timer5" Tag="5" Style="{StaticResource ChoiceButton}" Padding="9,0" Margin="0,0,4,0" Content="5&#x2032;" />
          <Button Focusable="False" x:Name="Timer15" Tag="15" Style="{StaticResource ChoiceButton}" Padding="9,0" Margin="0,0,4,0" Content="15&#x2032;" />
          <Button Focusable="False" x:Name="Timer25" Tag="25" Style="{StaticResource ChoiceButton}" Padding="9,0" Margin="0,0,4,0" Content="25&#x2032;" />
          <Button Focusable="False" x:Name="Timer45" Tag="45" Style="{StaticResource ChoiceButton}" Padding="9,0" Content="45&#x2032;" />
        </StackPanel>
      </StackPanel>
      <Button Focusable="False" x:Name="MirrorButton" Style="{StaticResource MirrorChip}" Padding="9,0" VerticalAlignment="Center"
              Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="MirrorGlyph" FontFamily="{StaticResource FluentRegular}" FontSize="11"
                     VerticalAlignment="Center" Margin="0,0,5,0" />
          <TextBlock x:Name="MirrorLabel" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </StackPanel>
    <!-- The Control Panel (gear) and Quit (power), at the right, as on the Mac. The shelf's link comes before them, shown only
         while the shelf is on, empty and no file is dragged over the pill. -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Focusable="False" x:Name="ShelfLink" Style="{StaticResource LinkChoice}" Margin="0,0,10,0" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="ShelfGlyph" FontFamily="{StaticResource FluentRegular}" FontSize="11"
                     VerticalAlignment="Center" Margin="0,0,5,0" />
          <TextBlock x:Name="ShelfLabel" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <Button Focusable="False" x:Name="ControlPanelButton" Style="{StaticResource FooterButton}" Margin="0,0,6,0"
              Content="&#xF6A9;" ToolTip="{l:L Control Panel}" />
      <Button Focusable="False" x:Name="QuitButton" Style="{StaticResource FooterButton}"
              Content="&#xF60E;" ToolTip="{l:L Quit}" />
    </StackPanel>
  </Grid>
</UserControl>
