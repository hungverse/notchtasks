<UserControl x:Class="NotchTasks.Pill.QuickBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NotchTasks.ControlPanel"
             Height="26" FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PillStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <!-- The timer pills of the timer module go here, at the left. -->
    <StackPanel x:Name="TimerPills" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" />
    <!-- The Control Panel (gear) and Quit (power), at the right, as on the Mac. -->
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="ControlPanelButton" Style="{StaticResource FooterButton}" Margin="0,0,6,0"
              Content="&#xE713;" ToolTip="{l:L Control Panel}" />
      <Button x:Name="QuitButton" Style="{StaticResource FooterButton}"
              Content="&#xE7E8;" ToolTip="{l:L Quit}" />
    </StackPanel>
  </Grid>
</UserControl>
