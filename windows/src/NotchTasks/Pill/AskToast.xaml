<UserControl x:Class="NotchTasks.Pill.AskToast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="520" HorizontalAlignment="Center" VerticalAlignment="Top"
             FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="AskStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <!-- The toast sits in the pill: its first row is the pill's own 32 px row, with the agent's glyph at the left. -->
  <Grid x:Name="Root" Background="Transparent">
    <Grid.RowDefinitions>
      <RowDefinition Height="32" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="Glyph" Grid.Row="0" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14"
               Foreground="{StaticResource AskOrange}" />
    <Grid Grid.Row="1" Margin="18,2,18,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
        <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="SubtitleText" FontSize="11" Foreground="#99FFFFFF" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="ReplyButton" Style="{StaticResource PrimaryChoice}" Height="24" Padding="11,0" Visibility="Collapsed" />
        <StackPanel x:Name="ApprovalButtons" Orientation="Horizontal">
          <Button x:Name="DenyButton" Style="{StaticResource ChoiceButton}" Height="24" Padding="11,0" Margin="0,0,6,0" />
          <Button x:Name="AllowButton" Style="{StaticResource PrimaryChoice}" Height="24" Padding="11,0" />
        </StackPanel>
        <Button x:Name="HideButton" Style="{StaticResource CloseButton}" Margin="6,0,0,0">
          <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9" FontWeight="Bold"
                     Foreground="#B3FFFFFF" />
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
