<Window x:Class="NotchTasks.Pill.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pill="clr-namespace:NotchTasks.Pill"
        xmlns:l="clr-namespace:NotchTasks.ControlPanel"
        Title="NotchTasks"
        Width="560" Height="420"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ThemeMode="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="White">
  <Window.Resources>
    <pill:RadiusConverter x:Key="RadiusConverter" />
    <!-- The pill keeps its own look: ThemeMode None above stops the Windows theme from restyling it, so its scrollbars and
         tooltips are styled here, in the Mac's dark pill colours, for both light and dark Windows. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Width="6" HorizontalAlignment="Center" CornerRadius="3" Background="#66FFFFFF" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#FF1C1C1E" />
      <Setter Property="BorderBrush" Value="#33FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HasDropShadow" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- A round 26 px button on the open pill. Its template is explicit, so the Windows theme does not restyle it. -->
    <Style x:Key="FooterButton" TargetType="Button">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#33FFFFFF" />
      <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" CornerRadius="13" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="Background" Value="#66FFFFFF" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Body" Property="Background" Value="#99FFFFFF" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Background="Transparent">
    <!-- The shadow and the glow sit behind the pill as siblings, so a sprite frame never redraws their effects. -->
    <Border x:Name="ShadowShape"
            Width="{Binding Width, ElementName=PillShape}" Height="{Binding Height, ElementName=PillShape}"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Background="Black" Opacity="0" IsHitTestVisible="False"
            CornerRadius="{Binding Radius, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource RadiusConverter}}">
    </Border>
    <Border x:Name="GlowBacking" Visibility="Collapsed" BorderThickness="1.2" IsHitTestVisible="False"
            Width="{Binding Width, ElementName=PillShape}" Height="{Binding Height, ElementName=PillShape}"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            CornerRadius="{Binding Radius, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource RadiusConverter}}">
    </Border>
    <!-- The pill: its Width, Height and CornerRadius animate. Its rectangle is the hover area, even when it is invisible. -->
    <Border x:Name="PillShape"
            Width="200" Height="32"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Background="Black"
            CornerRadius="{Binding Radius, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource RadiusConverter}}">
      <Grid x:Name="PillContent">
        <Border x:Name="Tint" Opacity="0" IsHitTestVisible="False" Background="Black"
                CornerRadius="{Binding Radius, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource RadiusConverter}}" />
        <Grid>
          <Grid x:Name="TopRow" Height="32" VerticalAlignment="Top">
            <StackPanel x:Name="LeftWing" Orientation="Horizontal" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Margin="12,0,0,0" />
            <StackPanel x:Name="RightWing" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0,0,12,0" />
          </Grid>
          <!-- The open pill: the ask cards (oldest first), or the placeholder when no ask waits. Hit-testable only while open. -->
          <Grid x:Name="CardLayer" Margin="0,32,0,0" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="CardText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" />
            <!-- The bottom 32 DIP are kept for the footer, so the cards never sit under its buttons. -->
            <ScrollViewer x:Name="AskScroll" Width="520" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Margin="0,0,0,32" Padding="10" Background="Transparent" BorderThickness="0"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel x:Name="AskList" />
            </ScrollViewer>
            <!-- The footer of the open pill, bottom right as on the Mac: the Control Panel (gear) and Quit (power). -->
            <StackPanel x:Name="Footer" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,12,6">
              <Button x:Name="ControlPanelButton" Style="{StaticResource FooterButton}" Margin="0,0,6,0"
                      Content="&#xE713;" ToolTip="{l:L Control Panel}" />
              <Button x:Name="QuitButton" Style="{StaticResource FooterButton}"
                      Content="&#xE7E8;" ToolTip="{l:L Quit}" />
            </StackPanel>
          </Grid>
        </Grid>
        <!-- The ask toast: the pill's top shape while an ask has just come in. Hit-testable only while it shows. -->
        <pill:AskToast x:Name="Toast" Opacity="0" IsHitTestVisible="False" />
        <Border x:Name="GlowRing" Visibility="Collapsed" IsHitTestVisible="False" BorderThickness="1.2"
                CornerRadius="{Binding Radius, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource RadiusConverter}}" />
      </Grid>
    </Border>
  </Grid>
</Window>
