<Window x:Class="NotchTasks.Pill.PillWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:fi="clr-namespace:NotchTasks"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:pill="clr-namespace:NotchTasks.Pill"
        Title="NotchTasks"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ThemeMode="None"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Foreground="White">
  <Window.Resources>
    <!-- The pill keeps its own look: ThemeMode None above stops the Windows theme from restyling it, so its scrollbars and
         tooltips are styled here, in the Mac's dark pill colours, for both light and dark Windows. -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}"
                   Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                   Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border Width="6" HorizontalAlignment="Center" CornerRadius="3" Background="#66FFFFFF" />
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ToolTip">
      <Setter Property="OverridesDefaultStyle" Value="True" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Background" Value="#FF1C1C1E" />
      <Setter Property="BorderBrush" Value="#33FFFFFF" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HasDropShadow" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Background="Transparent">
    <!-- The shadow and the glow sit behind the pill as siblings, so a sprite frame never redraws their effects. They are
         paths on the pill's one shared shape (Data set in code), in the layout's size, so they never re-measure while it moves. -->
    <Path x:Name="ShadowShape" Fill="Black" Opacity="0" IsHitTestVisible="False"
          HorizontalAlignment="Center" VerticalAlignment="Top" Stretch="None" />
    <Path x:Name="GlowBacking" Visibility="Collapsed" StrokeThickness="1.2" IsHitTestVisible="False"
          HorizontalAlignment="Center" VerticalAlignment="Top" Stretch="None" />
    <!-- The pill: a grid of the layout's size, never animated. Its black is ShapeFill, drawn on the shared shape; the content is
         clipped to that shape. Its rectangle is the hover area, even when it is invisible. -->
    <Grid x:Name="PillShape"
          HorizontalAlignment="Center" VerticalAlignment="Top" Background="Transparent">
      <Path x:Name="ShapeFill" Fill="Black" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None" />
      <Grid x:Name="PillContent">
        <Path x:Name="Tint" Opacity="0" IsHitTestVisible="False" Fill="Black"
              HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None" />
        <Grid>
          <Grid x:Name="TopRow" Height="32" VerticalAlignment="Top">
            <!-- No margin: the closed pill's padding is PillGeometry's, and the open pill's inset is the code's (Animate). -->
            <StackPanel x:Name="LeftWing" Orientation="Horizontal" HorizontalAlignment="Left"
                        VerticalAlignment="Center" Margin="0">
              <StackPanel.RenderTransform>
                <TranslateTransform x:Name="LeftWingShift" />
              </StackPanel.RenderTransform>
            </StackPanel>
            <StackPanel x:Name="RightWing" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Margin="0">
              <StackPanel.RenderTransform>
                <TranslateTransform x:Name="RightWingShift" />
              </StackPanel.RenderTransform>
            </StackPanel>
          </Grid>
          <!-- The open pill: the sections (the agents' cards, and the others), or the placeholder when none has anything.
               Hit-testable only while open. -->
          <!-- Its height is set per open (Animate), and it sits at the top below the top row, so the quick bar at its bottom is the shape's. -->
          <Grid x:Name="CardLayer" Margin="0,32,0,0" VerticalAlignment="Top" Opacity="0" Visibility="Hidden" IsHitTestVisible="False">
            <!-- The header: the summary at the left, in grey (Mac expandedView). -->
            <TextBlock x:Name="HeaderSummary" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,8,0,0"
                       FontSize="11" FontWeight="SemiBold" Foreground="Gray" />
            <!-- The CPU and RAM meters take the summary's place while SystemLoad is on and a load is known (NotchView.swift). -->
            <StackPanel x:Name="LoadMeters" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="16,4,0,0" Visibility="Collapsed" />
            <!-- The temperature, at the right of the header (NotchView.swift): a thermometer and the whole degrees, in the tint of
                 Thermals.Tint. Shown only while a reading exists and SystemLoad is on. -->
            <StackPanel x:Name="TempReading" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,4,16,0" Visibility="Collapsed">
              <fi:FluentGlyph x:Name="TempGlyph" Size="12" Width="14" VerticalAlignment="Center" />
              <TextBlock x:Name="TempText" FontSize="11" FontWeight="SemiBold" Margin="4,0,0,0" VerticalAlignment="Center"
                         Typography.NumeralAlignment="Tabular" />
            </StackPanel>
            <!-- The bottom 32 DIP are kept for the quick bar, so the sections never sit under its buttons; the top 26 for the header. -->
            <ScrollViewer x:Name="SectionScroll" Width="520" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Margin="0,26,0,32" Padding="10" Background="Transparent" BorderThickness="0"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
              <StackPanel x:Name="SectionList" />
            </ScrollViewer>
            <!-- The body when no section has anything: "Nothing running", grey and centred, as the Mac's expandedView. It keeps the
                 sections' margins, so the open height counts them the same way. Its text shows only with no badge or chip. -->
            <Border x:Name="EmptyNote" Margin="0,26,0,32" VerticalAlignment="Top" HorizontalAlignment="Stretch">
              <TextBlock x:Name="EmptyText" Foreground="Gray" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" />
            </Border>
            <!-- The quick bar of the open pill, bottom: the timers, then the Control Panel (gear) and Quit (power). -->
            <pill:QuickBar x:Name="Bar" VerticalAlignment="Bottom" Margin="12,0,12,6" />
          </Grid>
        </Grid>
        <!-- The toast: the pill's top shape while a toast shows. Hit-testable only while it shows. -->
        <!-- Hidden until a toast shows: it is measured while hidden, so the toast's height is still known. -->
        <pill:ToastView x:Name="ToastBox" Opacity="0" Visibility="Hidden" IsHitTestVisible="False" />
        <!-- The volume or brightness bar: the same place as the toast, shown instead of it while a level changes (SyncLevel). -->
        <pill:LevelView x:Name="LevelBox" Opacity="0" Visibility="Hidden" IsHitTestVisible="False" />
      </Grid>
      <!-- The crisp ring: a full-opacity accent stroke on top of the fill, with no effect (the glow is the blurred layer behind).
           It sits outside PillContent's clip, so its whole stroke shows, and it is pixel-snapped. -->
      <Path x:Name="GlowRing" Visibility="Collapsed" IsHitTestVisible="False" StrokeThickness="2.4" SnapsToDevicePixels="True"
            HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None" />
    </Grid>
  </Grid>
</Window>
