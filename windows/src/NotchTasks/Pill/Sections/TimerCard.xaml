<UserControl x:Class="NotchTasks.Pill.Sections.TimerCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:fi="clr-namespace:NotchTasks"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NotchTasks.ControlPanel"
             FontFamily="Segoe UI Variable Text, Segoe UI" Foreground="White">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../AskStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <!-- Mac TimerCard (NotchView.swift): a progress ring, the time left, the length, the +1 and +5 pills and the stop button. -->
  <Border CornerRadius="14" Padding="10" Background="#0FFFFFFF">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid Width="34" Height="34" VerticalAlignment="Center">
        <Ellipse Width="31" Height="31" Stroke="#1FFFFFFF" StrokeThickness="3" />
        <Path x:Name="Ring" Stroke="#FF9F0A" StrokeThickness="3"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
        <fi:FluentGlyph x:Name="Glyph" Size="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF9F0A" />
      </Grid>
      <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="TimeText" FontSize="20" FontWeight="SemiBold" Text="0:00" />
        <TextBlock x:Name="CaptionText" FontSize="11" Foreground="#8E8E93" />
      </StackPanel>
      <Button Focusable="False" x:Name="PlusOneButton" Grid.Column="3" Style="{StaticResource ChoiceButton}" Content="+1&#x2032;"
              Margin="0,0,6,0" Click="OnPlusOne" />
      <Button Focusable="False" x:Name="PlusFiveButton" Grid.Column="4" Style="{StaticResource ChoiceButton}" Content="+5&#x2032;"
              Margin="0,0,6,0" Click="OnPlusFive" />
      <Button Focusable="False" x:Name="StopButton" Grid.Column="5" Width="26" Height="26" Padding="0" Cursor="Hand"
              FocusVisualStyle="{x:Null}" Background="#B3FF3B30" Foreground="White"
              FontSize="11"
              ToolTip="{l:L Stop timer}" Click="OnStop">
        <fi:FluentGlyph Code="&#xF72A;" Size="11" Foreground="White" />
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" CornerRadius="13" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="False" />
            </Border>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </Grid>
  </Border>
</UserControl>
