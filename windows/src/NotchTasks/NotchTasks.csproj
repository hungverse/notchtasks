<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>NotchTasks</RootNamespace>
    <AssemblyName>NotchTasks</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Windows SDK target: the app uses WinRT (SMTC, devices, camera, share). Core, the hook and the sensors stay net10.0-windows. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <ApplicationIcon>Assets\NotchTasks.ico</ApplicationIcon>
    <!-- The colour dialog of the Control Panel (ColorField) is WinForms' ColorDialog. Its namespaces are not imported
         into the app: the WPF names would clash, so the one file that needs it aliases them. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Required by LibraryImport (Pill\Win32.cs): the generated P/Invoke code is unsafe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF0001: ThemeMode (App.xaml) is marked experimental in WPF. The app uses it on purpose for the Control Panel. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\NotchTasks.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NotchTasks.Core\NotchTasks.Core.csproj" />
    <ProjectReference Include="..\NotchTasksHook\NotchTasksHook.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\NotchTasksSensors\NotchTasksSensors.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\mac\Resources\Sprites\**" Link="Sprites\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\mac\Sources\l10n-*.json" Link="l10n\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\electron\l10n\windows.json" Link="l10n\windows.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.4.1" />
  </ItemGroup>

  <!-- The hook is not referenced as an assembly; copy its files next to NotchTasks.exe explicitly. -->
  <Target Name="CopyHookExe" AfterTargets="Build">
    <MSBuild Projects="..\NotchTasksHook\NotchTasksHook.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="HookTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <HookOutDir>%(HookTargetPath.RootDir)%(HookTargetPath.Directory)</HookOutDir>
    </PropertyGroup>
    <ItemGroup>
      <HookFiles Include="$(HookOutDir)NotchTasksHook.exe;$(HookOutDir)NotchTasksHook.dll;$(HookOutDir)NotchTasksHook.deps.json;$(HookOutDir)NotchTasksHook.runtimeconfig.json" />
    </ItemGroup>
    <Copy SourceFiles="@(HookFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- The temperature helper (elevated only after the user's click) is copied next to NotchTasks.exe the same way, with what it
       needs to run from a copy: its files, System.Management and its dependency, and the runtime-specific assemblies folder that
       the deps file names. The optional files are copied only when the build produced them. NotchTasks.Core.dll is the app's own. -->
  <Target Name="CopySensorsExe" AfterTargets="Build">
    <MSBuild Projects="..\NotchTasksSensors\NotchTasksSensors.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="SensorsTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <SensorsOutDir>%(SensorsTargetPath.RootDir)%(SensorsTargetPath.Directory)</SensorsOutDir>
    </PropertyGroup>
    <ItemGroup>
      <SensorsFiles Include="$(SensorsOutDir)NotchTasksSensors.exe;$(SensorsOutDir)NotchTasksSensors.dll;$(SensorsOutDir)NotchTasksSensors.deps.json;$(SensorsOutDir)NotchTasksSensors.runtimeconfig.json" />
      <SensorsFiles Include="$(SensorsOutDir)System.Management.dll;$(SensorsOutDir)System.CodeDom.dll" Condition="Exists('$(SensorsOutDir)System.Management.dll')" />
      <SensorsRuntimeFiles Include="$(SensorsOutDir)runtimes\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(SensorsFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(SensorsRuntimeFiles)" DestinationFiles="@(SensorsRuntimeFiles->'$(OutDir)runtimes\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
