<Window x:Class="NotchTasks.Onboarding.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NotchTasks.ControlPanel"
        Title="{l:L Welcome to NotchTasks}"
        Width="640" Height="560"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- The page: scrolls when it is taller than the window. -->
    <ScrollViewer Grid.Row="0" Padding="32,32,32,8" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" />
    </ScrollViewer>

    <!-- The footer: the step dots and "Step 1/5", then Skip, Back and Next. -->
    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="Dots" Orientation="Horizontal" VerticalAlignment="Center" />
        <TextBlock x:Name="StepText" Grid.Column="1" Style="{StaticResource CardNote}" Margin="10,0,0,0" VerticalAlignment="Center" />
        <Button x:Name="SkipButton" Grid.Column="3" Margin="0,0,8,0" IsCancel="True" />
        <Button x:Name="BackButton" Grid.Column="4" Margin="0,0,8,0" />
        <Button x:Name="NextButton" Grid.Column="5" MinWidth="96" IsDefault="True" />
      </Grid>
    </Border>
  </Grid>
</Window>
