<Window x:Class="NotchTasks.ControlPanel.ReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NotchTasks.ControlPanel"
        Title="{l:L Report a problem}"
        Width="500" SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <!-- The Mac's report sheet (MacReportSheet): the issue type, what happened, a contact, what is sent, the report code once it is
       sent, and the problem when it is not. The labels and texts are set by the window. -->
  <StackPanel Margin="20">
    <TextBlock x:Name="TopicLabel" Style="{StaticResource RowLabel}" />
    <ComboBox x:Name="TopicPicker" Margin="0,4,0,12" />

    <TextBlock x:Name="WhatLabel" Style="{StaticResource RowLabel}" />
    <TextBox x:Name="WhatBox" AcceptsReturn="True" TextWrapping="Wrap" MinLines="3" MaxLines="6"
             VerticalScrollBarVisibility="Auto" Margin="0,4,0,12" />

    <TextBlock x:Name="ContactLabel" Style="{StaticResource RowLabel}" />
    <TextBox x:Name="ContactBox" Margin="0,4,0,12" />

    <Expander x:Name="InfoExpander">
      <TextBlock x:Name="InfoText" Style="{StaticResource CardNote}" Margin="0,8,0,0" />
    </Expander>

    <StackPanel x:Name="ResultRow" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
      <TextBlock x:Name="ResultText" VerticalAlignment="Center" />
      <Button x:Name="CopyButton" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" />
    </StackPanel>

    <TextBlock x:Name="ProblemText" Foreground="{DynamicResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

    <Grid Margin="0,16,0,0">
      <Button x:Name="CloseButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" />
      <Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="96" />
    </Grid>
  </StackPanel>
</Window>
