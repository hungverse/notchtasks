<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The title of a pane: 28 px, semibold (Preferences.swift). -->
  <Style x:Key="PaneTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,8" />
  </Style>

  <!-- A short line under a pane's title. -->
  <Style x:Key="PaneNote" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- The heading of a section, above its card (Windows 11 Settings). -->
  <Style x:Key="SectionHeader" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,20,0,8" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
  </Style>

  <!-- A rounded card that holds the rows of a section. -->
  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <!-- One row of a card: a DockPanel whose control is docked right (Dock="Right") and whose label fills the rest. -->
  <Style x:Key="SettingRow" TargetType="DockPanel">
    <Setter Property="Margin" Value="16,10" />
    <Setter Property="LastChildFill" Value="True" />
  </Style>

  <!-- The label at the left of a row. -->
  <Style x:Key="RowLabel" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,16,0" />
  </Style>

  <!-- A line of text under a card: what the card's setting does. -->
  <Style x:Key="CardNote" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="4,6,0,0" />
    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- A picker's item: a colour dot (when the item has a Swatch) and the title. -->
  <DataTemplate x:Key="AccentChoice">
    <StackPanel Orientation="Horizontal">
      <Ellipse Width="12" Height="12" Margin="0,0,8,0" VerticalAlignment="Center"
               Fill="{Binding Swatch}" Stroke="{DynamicResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
      <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
    </StackPanel>
  </DataTemplate>

  <!-- A clickable tile with no button chrome: its content is the tile, and it dims a little under the mouse. -->
  <Style x:Key="TileButton" TargetType="Button">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter x:Name="Presenter" Content="{TemplateBinding Content}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Presenter" Property="Opacity" Value="0.8" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
