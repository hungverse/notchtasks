<local:SettingsPane x:Class="NotchTasks.ControlPanel.Panes.ModulesPane"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:l="clr-namespace:NotchTasks.ControlPanel"
                       xmlns:local="clr-namespace:NotchTasks.ControlPanel">
  <StackPanel>
    <TextBlock Style="{StaticResource PaneTitle}" Text="{l:L Modules}" />
    <TextBlock Style="{StaticResource PaneNote}" Text="{l:L Use the arrows to reorder the modules on the notch.}" />

    <!-- The column names, over the controls of each row (the same columns as a row's first line). -->
    <Grid Margin="16,20,16,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="60" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="170" />
        <ColumnDefinition Width="60" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="3" Style="{StaticResource CardNote}" Margin="0" Text="{l:L Position when collapsed}" />
      <TextBlock Grid.Column="4" Style="{StaticResource CardNote}" Margin="0" HorizontalAlignment="Center" Text="{l:L On}" />
    </Grid>

    <Border Style="{StaticResource Card}">
      <StackPanel x:Name="Rows" />
    </Border>
  </StackPanel>
</local:SettingsPane>
