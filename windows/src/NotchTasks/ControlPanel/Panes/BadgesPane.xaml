<local:SettingsPane x:Class="NotchTasks.ControlPanel.Panes.BadgesPane"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:l="clr-namespace:NotchTasks.ControlPanel"
                       xmlns:local="clr-namespace:NotchTasks.ControlPanel">
  <StackPanel>
    <TextBlock Style="{StaticResource PaneTitle}" Text="{l:L Icons &amp; lock}" />
    <TextBlock Style="{StaticResource PaneNote}" Text="{l:L Icons always shown on the collapsed notch.}" />

    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:L Main screen}" />
    <Border Style="{StaticResource Card}" Padding="16">
      <StackPanel>
        <!-- The closed notch as the pill draws it: the icons on the left, the camera, the icons on the right. -->
        <Border Background="Black" CornerRadius="0,0,14,14" Padding="12,10">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="LeftWing" Orientation="Horizontal" HorizontalAlignment="Right" />
            <Border Grid.Column="1" Width="64" Height="22" CornerRadius="6" Background="#FF1B1B1B" Margin="10,0" />
            <StackPanel x:Name="RightWing" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" />
          </Grid>
        </Border>
        <TextBlock x:Name="HintText" Style="{StaticResource CardNote}" Margin="0,10,0,0" />

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button x:Name="LibraryButton" Content="{l:L Add from Icon Library}" />
          <Button x:Name="SyncButton" Margin="8,0,0,0" Visibility="Collapsed"
                  Content="{l:L Sync motion}" ToolTip="{l:L Restart every animated icon at once}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- The icon selected on the board: its preview, its position, its symbol and its style. -->
    <StackPanel x:Name="Editor" Visibility="Collapsed">
      <TextBlock Style="{StaticResource SectionHeader}" Text="{l:L Selected icon}" />
      <Border Style="{StaticResource Card}" Padding="16,14">
        <StackPanel>
          <DockPanel>
            <Border x:Name="EditorPreview" DockPanel.Dock="Left" Width="56" Height="56" CornerRadius="12"
                    Background="Black" Margin="0,0,14,0" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="EditorTitle" FontWeight="SemiBold" />
              <TextBlock x:Name="EditorSide" Style="{StaticResource CardNote}" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button x:Name="MoveEarlierButton" Content="{l:L Move earlier}" />
            <Button x:Name="MoveLaterButton" Margin="8,0,0,0" Content="{l:L Move later}" />
            <Button x:Name="RemoveButton" Margin="8,0,0,0" Content="{l:L Remove icon}" />
          </StackPanel>

          <local:BadgeEditorBody x:Name="Body" ShowLibrary="True" />
        </StackPanel>
      </Border>
    </StackPanel>
  </StackPanel>
</local:SettingsPane>
