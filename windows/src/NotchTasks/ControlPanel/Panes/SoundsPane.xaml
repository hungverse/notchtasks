<local:SettingsPane x:Class="NotchTasks.ControlPanel.Panes.SoundsPane"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:l="clr-namespace:NotchTasks.ControlPanel"
                       xmlns:local="clr-namespace:NotchTasks.ControlPanel">
  <local:SettingsPane.Resources>
    <!-- A sound picker's item: a rule for the separator, the title for the rest. -->
    <DataTemplate x:Key="SoundItem" DataType="{x:Type l:Choice}">
      <StackPanel>
        <Separator x:Name="Rule" Visibility="Collapsed" Margin="0,4" />
        <TextBlock x:Name="Text" Text="{Binding Title}" />
      </StackPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
          <Setter TargetName="Rule" Property="Visibility" Value="Visible" />
          <Setter TargetName="Text" Property="Visibility" Value="Collapsed" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </local:SettingsPane.Resources>
  <StackPanel>
    <TextBlock Style="{StaticResource PaneTitle}" Text="{l:L Sound}" />
    <TextBlock Style="{StaticResource PaneNote}" Text="{l:L The sounds that play when a task finishes or needs you.}" />

    <Border Style="{StaticResource Card}">
      <StackPanel>
        <DockPanel Style="{StaticResource SettingRow}">
          <CheckBox x:Name="SoundOn" DockPanel.Dock="Right" VerticalAlignment="Center" />
          <TextBlock Style="{StaticResource RowLabel}" Text="{l:L Sound}" />
        </DockPanel>
        <DockPanel Style="{StaticResource SettingRow}">
          <Slider x:Name="VolumeSlider" DockPanel.Dock="Right" Width="220" Minimum="0" Maximum="1"
                  VerticalAlignment="Center" />
          <TextBlock Style="{StaticResource RowLabel}" Text="{l:L Volume}" />
        </DockPanel>
        <DockPanel Style="{StaticResource SettingRow}">
          <ComboBox x:Name="PackBox" DockPanel.Dock="Right" Width="220" DisplayMemberPath="Title" />
          <TextBlock Style="{StaticResource RowLabel}" Text="{l:L Sound pack}" />
        </DockPanel>
        <DockPanel Style="{StaticResource SettingRow}">
          <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button x:Name="ExportButton" Margin="0,0,8,0" Padding="10,4" />
            <Button x:Name="ImportButton" Padding="10,4" />
          </StackPanel>
          <TextBlock x:Name="BackupLabel" Style="{StaticResource RowLabel}" />
        </DockPanel>
      </StackPanel>
    </Border>
    <TextBlock x:Name="PackFooter" Style="{StaticResource CardNote}" Margin="4,8,0,0" TextWrapping="Wrap" />

    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:L Events}" />
    <!-- One row per event, built in code: the event's title, its sound's picker and a button that plays the sound. The rows
         are off while sounds are off (Preferences.swift: .disabled(!settings.sounds)). -->
    <Border x:Name="EventsCard" Style="{StaticResource Card}">
      <StackPanel x:Name="EventRows" />
    </Border>
  </StackPanel>
</local:SettingsPane>
