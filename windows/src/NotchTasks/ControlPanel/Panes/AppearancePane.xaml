<local:SettingsPane x:Class="NotchTasks.ControlPanel.Panes.AppearancePane"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:l="clr-namespace:NotchTasks.ControlPanel"
                       xmlns:local="clr-namespace:NotchTasks.ControlPanel"
                       xmlns:fi="clr-namespace:NotchTasks">
  <StackPanel>
    <TextBlock Style="{StaticResource PaneTitle}" Text="{l:L Appearance}" />
    <TextBlock Style="{StaticResource PaneNote}" Text="{l:L How the notch and its alerts look.}" />

    <!-- The top card, as the Mac's: the live preview, full width, with the "Test alert" button at the card's right edge. -->
    <Border Style="{StaticResource Card}" Padding="0" UseLayoutRounding="True">
      <Grid Margin="0,0,0,16">
        <!-- The screen's top edge: a 1 DIP rule flush with the card's top, across its full width. -->
        <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
        <!-- The island floats 4 DIP below the edge, as on the Mac. -->
        <Border x:Name="PreviewGlow" Width="200" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"
                CornerRadius="16" BorderThickness="1.5" Visibility="Collapsed" />
        <Border x:Name="PreviewPill" Width="200" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"
                CornerRadius="16" Background="Black">
          <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="6" ShadowDepth="2" Direction="270" />
          </Border.Effect>
        </Border>
        <Border x:Name="PreviewRing" Width="200" Height="32" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0"
                CornerRadius="16" BorderThickness="1.5" Visibility="Collapsed" SnapsToDevicePixels="True" />
        <Border x:Name="PreviewToast" Width="260" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,44,0,0" Padding="14,10"
                CornerRadius="18" Background="Black">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- the done toast's glyph: a 16 DIP glyph, centred (FluentGlyph); its colour is set by the pane -->
            <fi:FluentGlyph x:Name="PreviewGlyph" Code="&#xF294;" Size="16" VerticalAlignment="Center" Margin="0,0,10,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <TextBlock x:Name="PreviewTitle" Text="{l:L Task finished}" Foreground="White" FontSize="13"
                         FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{l:L Test alert}" Foreground="#99FFFFFF" FontSize="11" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- The Mac's "Test alert": a task-finished toast in the current style, with the sound and no system notification. It sits
             in the card's top right corner, clear of the preview. -->
        <Button x:Name="TestAlertButton" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,16,0" Padding="12,4"
                Style="{StaticResource PrimaryButton}">
          <StackPanel Orientation="Horizontal">
            <!-- the bell, white, centred (FluentGlyph) -->
            <fi:FluentGlyph Code="&#xF0F4;" Size="16" Foreground="White" Margin="0,0,8,0" />
            <TextBlock x:Name="TestAlertLabel" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- The one-click themes (the Mac's Theme.all): a tile per theme, built in code, three across with 12 DIP gaps. Each tile has
         6 DIP around it, and the grid reaches 6 DIP past the pane's edges, so the outer tiles sit flush with the pane. -->
    <UniformGrid x:Name="ThemeGrid" Columns="3" Margin="-6,12,-6,0" />

    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:L Notch}" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <DockPanel Style="{StaticResource SettingRow}">
          <ComboBox x:Name="BackgroundBox" DockPanel.Dock="Right" Width="220" DisplayMemberPath="Title" />
          <TextBlock Style="{StaticResource RowLabel}" Text="{l:L Background}" />
        </DockPanel>
        <DockPanel x:Name="TopRow" Style="{StaticResource SettingRow}">
          <local:ColorField x:Name="TopColor" DockPanel.Dock="Right" />
          <TextBlock Style="{StaticResource RowLabel}" Text="{l:L Top color}" />
        </DockPanel>
        <DockPanel x:Name="BottomRow" Style="{StaticResource SettingRow}">
          <local:ColorField x:Name="BottomColor" DockPanel.Dock="Right" />
          <TextBlock Style="{StaticResource RowLabel}" Text="{l:L Bottom color}" />
        </DockPanel>
        <DockPanel Style="{StaticResource SettingRow}">
          <ComboBox x:Name="SizeBox" DockPanel.Dock="Right" Width="220" DisplayMemberPath="Title" />
          <TextBlock Style="{StaticResource RowLabel}" Text="{l:L Size}" />
        </DockPanel>
        <DockPanel Style="{StaticResource SettingRow}">
          <ComboBox x:Name="MotionBox" DockPanel.Dock="Right" Width="220" DisplayMemberPath="Title" />
          <TextBlock Style="{StaticResource RowLabel}" Text="{l:L Motion}" />
        </DockPanel>
      </StackPanel>
    </Border>
    <TextBlock x:Name="NotchNote" Style="{StaticResource CardNote}" />

    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:L Notifications}" />
    <Border Style="{StaticResource Card}">
      <DockPanel Style="{StaticResource SettingRow}">
        <ComboBox x:Name="ToastBox" DockPanel.Dock="Right" Width="220" DisplayMemberPath="Title" />
        <TextBlock Style="{StaticResource RowLabel}" Text="{l:L Style}" />
      </DockPanel>
    </Border>
    <TextBlock Style="{StaticResource CardNote}" Text="{Binding SelectedItem.Blurb, ElementName=ToastBox}" />

    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:L Color}" />
    <Border Style="{StaticResource Card}">
      <StackPanel>
        <DockPanel Style="{StaticResource SettingRow}">
          <ComboBox x:Name="AccentBox" DockPanel.Dock="Right" Width="220"
                    ItemTemplate="{StaticResource AccentChoice}" />
          <TextBlock Style="{StaticResource RowLabel}" Text="{l:L Accent color}" />
        </DockPanel>
        <DockPanel x:Name="CustomAccentRow" Style="{StaticResource SettingRow}">
          <local:ColorField x:Name="CustomAccent" DockPanel.Dock="Right" />
          <TextBlock Style="{StaticResource RowLabel}" Text="{l:L Custom color}" />
        </DockPanel>
      </StackPanel>
    </Border>

    <!-- The profile file (the Mac's "Back up settings"): the customization in one .json file, the same format on both. -->
    <TextBlock x:Name="BackupHeader" Style="{StaticResource SectionHeader}" />
    <Border Style="{StaticResource Card}">
      <DockPanel Style="{StaticResource SettingRow}">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button x:Name="ExportButton" Margin="0,0,8,0" Padding="10,4" />
          <Button x:Name="ImportButton" Padding="10,4" />
        </StackPanel>
        <TextBlock x:Name="BackupLabel" Style="{StaticResource RowLabel}" />
      </DockPanel>
    </Border>
    <TextBlock x:Name="BackupFooter" Style="{StaticResource CardNote}" Margin="4,8,0,0" TextWrapping="Wrap" />
  </StackPanel>
</local:SettingsPane>
