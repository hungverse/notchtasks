<UserControl x:Class="NotchTasks.ControlPanel.Panes.BuildToolsBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NotchTasks.ControlPanel">
  <!-- The Build & CI box of the Watching pane: the tools this PC has built with, each with its icon. -->
  <Border Style="{StaticResource Card}" Padding="16">
    <StackPanel>
      <DockPanel>
        <CheckBox x:Name="ShowAllBox" DockPanel.Dock="Right" VerticalAlignment="Center" Content="{l:L Show all tools}" />
        <TextBlock Text="{l:L Build &amp; CI}" FontWeight="SemiBold" VerticalAlignment="Center" />
      </DockPanel>
      <TextBlock x:Name="CaptionText" Style="{StaticResource CardNote}" Margin="0,8,0,10" />
      <WrapPanel x:Name="Tools" />
    </StackPanel>
  </Border>
</UserControl>
