<UserControl x:Class="NotchTasks.ControlPanel.Panes.PairingPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NotchTasks.ControlPanel"
             xmlns:local="clr-namespace:NotchTasks.ControlPanel">
  <StackPanel>
    <!-- Without sync (no bridge) the pane says so and offers nothing else. -->
    <Border x:Name="UnavailableCard" Style="{StaticResource Card}" Padding="16" Visibility="Collapsed">
      <TextBlock x:Name="UnavailableText" TextWrapping="Wrap" />
    </Border>

    <StackPanel x:Name="Body">
      <!-- The status: the Pro line, the note of a Pro change, the three steps while no phone is paired, the code (its QR on a
           white card, its words and buttons), the problem, and Report a problem. The Mac's first section. -->
      <Border Style="{StaticResource Card}" Padding="16">
        <StackPanel>
          <TextBlock x:Name="ProText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock x:Name="ProNoteText" Style="{StaticResource CardNote}" Margin="0,6,0,0" />
          <TextBlock x:Name="IntroText" Style="{StaticResource CardNote}" Margin="0,8,0,0" />

          <StackPanel x:Name="StepsPanel" Margin="0,12,0,0">
            <TextBlock x:Name="Step1" FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap" />
            <TextBlock x:Name="Step2" FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap" />
            <TextBlock x:Name="Step3" FontSize="14" Margin="0,0,0,6" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel x:Name="CodePanel" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
            <!-- The QR is drawn as vectors (QrImage) at 240 DIP, with a white rounded card of 14 DIP padding (Mac). -->
            <Border Background="White" CornerRadius="14" Padding="14" VerticalAlignment="Top">
              <Image x:Name="QrCode" Width="240" Height="240" Stretch="Uniform"
                     RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Border>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center" MaxWidth="260">
              <TextBlock x:Name="CodeInstructions" TextWrapping="Wrap" />
              <TextBlock x:Name="CodeNote" Style="{StaticResource CardNote}" Margin="0,8,0,0" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="CopyButton" Style="{StaticResource SecondaryButton}" />
                <Button x:Name="HideButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" />
              </StackPanel>
            </StackPanel>
          </StackPanel>

          <Button x:Name="PairButton" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
          <Button x:Name="AnotherButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                  Visibility="Collapsed" />

          <StackPanel x:Name="ProblemRow" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ProblemGlyph" FontFamily="/NotchTasks;component/Resources/Fonts/#FluentSystemIcons-Regular" FontSize="14"
                       Foreground="#FF9F0A" Margin="0,0,8,0" VerticalAlignment="Center" />
            <TextBlock x:Name="ProblemText" Foreground="#FF9F0A" TextWrapping="Wrap" VerticalAlignment="Center" />
          </StackPanel>

          <Button x:Name="ReportButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" />
        </StackPanel>
      </Border>

      <!-- The connection, once a phone is paired: the two switches, the connection row, and the footer (Mac's second section). -->
      <Border x:Name="ConnectionCard" Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0" Visibility="Collapsed">
        <StackPanel>
          <CheckBox x:Name="LanSwitch" Style="{StaticResource Switch}" />
          <CheckBox x:Name="OnlyAwaySwitch" Style="{StaticResource Switch}" Margin="0,12,0,0" />
          <DockPanel Margin="0,12,0,0">
            <TextBlock x:Name="ConnectionValue" DockPanel.Dock="Right" HorizontalAlignment="Right" Margin="12,0,0,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextAlignment="Right" TextWrapping="Wrap" />
            <TextBlock x:Name="ConnectingLabel" VerticalAlignment="Center" />
          </DockPanel>
        </StackPanel>
      </Border>
      <TextBlock x:Name="SettingsNote" Style="{StaticResource CardNote}" Margin="12,6,12,0" TextWrapping="Wrap"
                 Visibility="Collapsed" />

      <!-- The paired phones, sorted by name, and Unpair all (Mac's third section). -->
      <TextBlock x:Name="PairedCaps" Style="{StaticResource GroupCaps}" Visibility="Collapsed" />
      <Border x:Name="PairedCard" Style="{StaticResource Card}" Padding="16,8" Visibility="Collapsed">
        <StackPanel>
          <StackPanel x:Name="PhoneRows" />
          <Button x:Name="UnpairAllButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                  Margin="0,8,0,8" />
        </StackPanel>
      </Border>
      <TextBlock x:Name="PairedNote" Style="{StaticResource CardNote}" Margin="12,6,12,0" TextWrapping="Wrap"
                 Visibility="Collapsed" />
    </StackPanel>
  </StackPanel>
</UserControl>
