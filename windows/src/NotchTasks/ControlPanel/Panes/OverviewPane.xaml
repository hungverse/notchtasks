<local:SettingsPane x:Class="NotchTasks.ControlPanel.Panes.OverviewPane"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:l="clr-namespace:NotchTasks.ControlPanel"
                       xmlns:local="clr-namespace:NotchTasks.ControlPanel">
  <StackPanel>
    <TextBlock Style="{StaticResource PaneTitle}" Text="{l:L Overview}" />
    <!-- The note is set by the pane: its text has an apostrophe, which a {l:L} attribute cannot hold. -->
    <TextBlock x:Name="Note" Style="{StaticResource PaneNote}" />

    <!-- The stats: the modules on, the agents watched. Each tile is built by the pane. -->
    <UniformGrid x:Name="Stats" Columns="2" Margin="0,20,0,0" />

    <!-- The next steps: shown after the first run, while something is still to do. Rows are built by the pane. -->
    <StackPanel x:Name="NextStepsSection" Visibility="Collapsed">
      <TextBlock Style="{StaticResource SectionHeader}" Text="{l:L Next steps}" />
      <Border Style="{StaticResource Card}">
        <StackPanel x:Name="NextStepRows" />
      </Border>
    </StackPanel>

    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:L Modules}" />
    <UniformGrid x:Name="ModuleCells" Columns="2" />

    <Button x:Name="GuideButton" HorizontalAlignment="Left" Margin="0,20,0,0" Content="{l:L See the guide}" />
  </StackPanel>
</local:SettingsPane>
