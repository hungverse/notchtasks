<local:SettingsPane x:Class="NotchTasks.ControlPanel.Panes.OverviewPane"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:l="clr-namespace:NotchTasks.ControlPanel"
                       xmlns:local="clr-namespace:NotchTasks.ControlPanel">
  <StackPanel>
    <!-- The hero, as the Mac's overview: the notch on a purple wash with a sample of the pill (its sparkle, its count and
         its hammer), beside the app's name. The note is set by the pane: its text has an apostrophe, which a {l:L}
         attribute cannot hold. -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Width="280" Height="70" CornerRadius="10" VerticalAlignment="Center">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#B35856D6" Offset="0" />
            <GradientStop Color="#80AF52DE" Offset="1" />
          </LinearGradientBrush>
        </Border.Background>
        <Border Width="220" Height="30" VerticalAlignment="Top" HorizontalAlignment="Center"
                Background="Black" CornerRadius="0,0,10,10">
          <!-- The Mac's notch preview, live: the running count on the left (sparkle, count, working bars), the alerts on the
               right (wrench, progress ring). Each side is empty when its count is 0. OverviewPane fills both. -->
          <Grid Margin="10,0">
            <StackPanel x:Name="RunningPart" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" />
            <StackPanel x:Name="AlertPart" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Border>
      </Border>
      <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="NotchTasks" FontSize="28" FontWeight="Bold" />
        <TextBlock x:Name="Note" Style="{StaticResource PaneNote}" Margin="0,4,0,0" />
      </StackPanel>
    </Grid>

    <!-- The stats: the agents running now, the CI errors, the permissions granted. Each card is built by the pane. -->
    <UniformGrid x:Name="Stats" Columns="3" Margin="0,20,0,0" />

    <!-- The next steps: shown after the first run, while something is still to do. Each step is a card of its own. -->
    <StackPanel x:Name="NextStepsSection" Visibility="Collapsed">
      <TextBlock Style="{StaticResource SectionHeader}" Text="{l:L Next steps}" />
      <StackPanel x:Name="NextStepRows" />
    </StackPanel>

    <TextBlock x:Name="ErrorText" Style="{StaticResource CardNote}" Margin="0,8,0,0" Visibility="Collapsed"
               Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

    <TextBlock Style="{StaticResource SectionHeader}" Text="{l:L Modules}" />
    <!-- The module groups (Work, Music &amp; devices, ...): a caps heading and a two-column grid of switches for each. -->
    <StackPanel x:Name="ModuleGroups" />

    <Button x:Name="GuideButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,20,0,0"
            Content="{l:L See the guide}" />

    <!-- Always there, as the Mac's overview: a report can be sent even with sync off (the dialog says why it cannot send). -->
    <Button x:Name="ReportButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
            Content="{l:L Report a problem}" />
  </StackPanel>
</local:SettingsPane>
