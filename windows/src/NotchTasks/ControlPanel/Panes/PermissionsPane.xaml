<local:SettingsPane x:Class="NotchTasks.ControlPanel.Panes.PermissionsPane"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:l="clr-namespace:NotchTasks.ControlPanel"
                       xmlns:local="clr-namespace:NotchTasks.ControlPanel">
  <StackPanel>
    <TextBlock Style="{StaticResource PaneTitle}" Text="{l:L Permissions}" />
    <TextBlock Style="{StaticResource PaneNote}" Text="{l:L Only grant permissions for features you use. Turn a feature off completely on the Modules page.}" />

    <!-- The groups (Needed now, Granted, Not in use): each is one card, its title first; built by the pane. -->
    <StackPanel x:Name="Groups" Margin="0,16,0,0" />

    <TextBlock x:Name="ErrorText" Style="{StaticResource CardNote}" Margin="0,4,0,0"
               Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />

    <!-- Refresh sits at the foot, as the Mac's. -->
    <Button x:Name="RefreshButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,16,0,0"
            Content="{l:L Refresh}" />
  </StackPanel>
</local:SettingsPane>
