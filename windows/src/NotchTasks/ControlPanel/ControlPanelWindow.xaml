<Window x:Class="NotchTasks.ControlPanel.ControlPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:NotchTasks.ControlPanel"
        xmlns:local="clr-namespace:NotchTasks"
        Title="{l:L Control Panel}"
        Width="900" Height="640"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <Window.Resources>
    <ResourceDictionary>
      <!-- Every CheckBox in the Control Panel is a Windows 11 toggle switch (Controls.xaml). Other windows keep the Fluent box.
           The accent and the sliders are the Windows theme's own: the Control Panel follows the system accent. -->
      <Style TargetType="CheckBox" BasedOn="{StaticResource Switch}" />
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- The sidebar sits on the window's backdrop (Mica on Windows 11), with no panel of its own, as Windows 11 Settings
         has it. Its text colours are the Windows theme's own brushes, so the window follows light and dark mode. -->
    <Border Grid.Column="0" Margin="10">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- One row per pane, with its icon and title: 36 DIP, as the Windows 11 NavigationView. The selected row has a subtle fill
             and the accent pill at its left edge. -->
        <ListBox x:Name="Sidebar" BorderThickness="0" Background="Transparent"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Padding" Value="12,0" />
              <Setter Property="MinHeight" Value="36" />
              <!-- the pane name is the item's accessible name (the row is otherwise announced as its class name) -->
              <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
              <Setter Property="Margin" Value="0,0,0,2" />
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              <Setter Property="FocusVisualStyle" Value="{x:Null}" />
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <!-- The Body is 4 DIP rounded. The padding is on the content, so the accent pill sits at the row's edge. -->
                    <Border x:Name="Body" CornerRadius="4" Background="{TemplateBinding Background}">
                      <Grid>
                        <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <!-- The hover tint is listed before the selection, so a selected row keeps its fill under the mouse. -->
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Body" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="Body" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal">
                <!-- the icon is 16 DIP, centred in its box, and a 4 DIP gap follows it (Windows 11 NavigationView) -->
                <local:FluentGlyph Code="{Binding Glyph}" Size="16" VerticalAlignment="Center" Margin="0,0,4,0" />
                <TextBlock Text="{Binding Title}" FontSize="14" VerticalAlignment="Center" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <!-- The app version and its update line, at the foot of the sidebar, under a hairline. -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
          <l:UpdateFooter x:Name="Footer" />
        </Border>
      </Grid>
    </Border>

    <!-- The detail area: the selected pane, scrolling when it is taller than the window. -->
    <!-- The margin is on the host: ContentControl's template ignores Padding, so panes would touch the edges. Every pane fills
         the same column: the host stretches to the viewport (the ScrollViewer gives it the viewport's width, with no horizontal
         scrolling) and is capped at 760 DIP, left-aligned, so a pane's width never depends on its content. -->
    <ScrollViewer x:Name="PaneScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ContentControl x:Name="PaneHost" Margin="32,24,32,32" MaxWidth="760" HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" />
    </ScrollViewer>
  </Grid>
</Window>
