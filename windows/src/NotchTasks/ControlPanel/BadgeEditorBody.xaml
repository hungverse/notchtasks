<UserControl x:Class="NotchTasks.ControlPanel.BadgeEditorBody"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NotchTasks.ControlPanel"
             xmlns:local="clr-namespace:NotchTasks.ControlPanel">
  <!-- The editor of one badge: what it shows (a symbol, letters, a picture or a GIF), and its style (shape, border, fill, ink).
       It holds no preview and no buttons of its own; the host (the Icons pane's editor, or the tool dialog) shows those around it. -->
  <StackPanel>
    <DockPanel Style="{StaticResource SettingRow}" Margin="0,8,0,0">
      <ComboBox x:Name="KindBox" DockPanel.Dock="Right" MinWidth="220" DisplayMemberPath="Title" />
      <TextBlock Style="{StaticResource RowLabel}" Text="{l:L Content}" />
    </DockPanel>

    <!-- A symbol: one of the tiles -->
    <StackPanel x:Name="SymbolPanel">
      <TextBlock Style="{StaticResource CardNote}" Margin="4,12,0,6" Text="{l:L Symbol}" />
      <WrapPanel x:Name="SymbolGrid" />
    </StackPanel>

    <!-- Letters or an emoji: up to eight characters, with quick picks -->
    <StackPanel x:Name="TextPanel" Visibility="Collapsed">
      <TextBlock Style="{StaticResource CardNote}" Margin="4,12,0,6" Text="{l:L Type up to 8 characters}" />
      <TextBox x:Name="LetterBox" FontSize="18" MaxWidth="320" HorizontalAlignment="Left" />
      <TextBlock Style="{StaticResource CardNote}" Margin="4,12,0,6" Text="{l:L Quick picks}" />
      <WrapPanel x:Name="EmojiGrid" />
    </StackPanel>

    <!-- A picture: a copy of the file the user picks -->
    <StackPanel x:Name="PicturePanel" Visibility="Collapsed">
      <Button x:Name="PictureButton" HorizontalAlignment="Left" Margin="0,12,0,0" Content="{l:L Choose picture…}" />
      <TextBlock Style="{StaticResource CardNote}" Margin="4,8,0,0" Text="{l:L PNG\, JPG or GIF. Square pictures look best.}" />
    </StackPanel>

    <!-- An animated icon: a GIF the user picks, or one from the Icon Library -->
    <StackPanel x:Name="AnimationPanel" Visibility="Collapsed">
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button x:Name="GifButton" Content="{l:L Choose a GIF…}" />
        <Button x:Name="LibraryButton" Margin="8,0,0,0" Visibility="Collapsed" Content="{l:L Choose an animated icon…}" />
      </StackPanel>
      <TextBlock Style="{StaticResource CardNote}" Margin="4,8,0,0" Text="{l:L Animated characters\, GIFs}" />
    </StackPanel>

    <TextBlock x:Name="ErrorText" Style="{StaticResource CardNote}" Margin="4,10,0,0" TextWrapping="Wrap"
               Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />

    <TextBlock Style="{StaticResource CardNote}" Margin="4,16,0,0" Text="{l:L Style}" />
    <DockPanel Style="{StaticResource SettingRow}" Margin="0,6,0,0">
      <ComboBox x:Name="ShapeBox" DockPanel.Dock="Right" MinWidth="220" DisplayMemberPath="Title" />
      <TextBlock Style="{StaticResource RowLabel}" Text="{l:L Shape}" />
    </DockPanel>
    <DockPanel Style="{StaticResource SettingRow}" Margin="0">
      <CheckBox x:Name="BorderBox" DockPanel.Dock="Right" />
      <TextBlock Style="{StaticResource RowLabel}" Text="{l:L Border}" />
    </DockPanel>
    <DockPanel Style="{StaticResource SettingRow}" Margin="0">
      <CheckBox x:Name="NoFillBox" DockPanel.Dock="Right" />
      <TextBlock Style="{StaticResource RowLabel}" Text="{l:L No background}" />
    </DockPanel>
    <DockPanel Style="{StaticResource SettingRow}" Margin="0">
      <local:ColorField x:Name="FillColor" DockPanel.Dock="Right" />
      <TextBlock Style="{StaticResource RowLabel}" Text="{l:L Background color}" />
    </DockPanel>
    <!-- the ink of a symbol or of letters; a picture or a GIF has none -->
    <DockPanel x:Name="InkRow" Style="{StaticResource SettingRow}" Margin="0">
      <local:ColorField x:Name="SymbolColor" DockPanel.Dock="Right" />
      <TextBlock x:Name="InkLabel" Style="{StaticResource RowLabel}" Text="{l:L Symbol color}" />
    </DockPanel>
  </StackPanel>
</UserControl>
