<UserControl x:Class="NotchTasks.ControlPanel.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:NotchTasks.ControlPanel">
  <UserControl.Resources>
    <!-- A round swatch: its colour is the button's background. -->
    <Style x:Key="ColorSwatch" TargetType="Button">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Body" CornerRadius="11" Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" />
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>

  <!-- The swatches, the hex text and the colour dialog's button, at the right of a row. -->
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
    <StackPanel x:Name="Swatches" Orientation="Horizontal" VerticalAlignment="Center" />
    <TextBox x:Name="HexBox" MinWidth="104" MaxLength="7" VerticalContentAlignment="Center" Margin="0,0,6,0"
             ToolTip="#RRGGBB" KeyDown="OnHexKeyDown" LostFocus="OnHexLostFocus" />
    <Button x:Name="PickButton" Content="…" Width="34" Height="30" ToolTip="{l:L Choose a colour}" Click="OnPickClick" />
  </StackPanel>
</UserControl>
