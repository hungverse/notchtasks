<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- The Mac app uses system blue for its settings window, not the accent the user picked in Windows. A Windows accent is
       a dull slate on some PCs, so the Control Panel windows merge this dictionary: their DynamicResource lookups find these
       keys before the theme's. The Color keys cover the theme's own controls (sliders, check boxes, focus rings). -->
  <Color x:Key="SystemAccentColor">#0A84FF</Color>
  <Color x:Key="SystemAccentColorLight1">#409CFF</Color>
  <Color x:Key="SystemAccentColorLight2">#64B5FF</Color>
  <Color x:Key="SystemAccentColorLight3">#8DC8FF</Color>
  <Color x:Key="SystemAccentColorDark1">#0A84FF</Color>
  <Color x:Key="SystemAccentColorDark2">#0070E0</Color>
  <Color x:Key="SystemAccentColorDark3">#005BB8</Color>

  <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0A84FF" />
  <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E60A84FF" />
  <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CC0A84FF" />
  <SolidColorBrush x:Key="AccentFillColorDisabledBrush" Color="#5C0A84FF" />
  <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#409CFF" />
  <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="White" />
</ResourceDictionary>
