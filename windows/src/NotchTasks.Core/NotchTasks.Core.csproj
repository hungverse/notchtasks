<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- No Windows SDK version: the Windows SDK projection (Microsoft.Windows.SDK.NET, WinRT.Runtime) is not needed here. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>NotchTasks.Core</RootNamespace>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Required by LibraryImport: the generated P/Invoke code is unsafe. The build fails (SYSLIB1062) without it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
