{
  "name": "notchtasks",
  "productName": "NotchTasks",
  "version": "2.2.0",
  "description": "NotchTasks for Windows: a pill at the top of the screen for tasks, agents and system stats",
  "main": "src/main/main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "dist:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "qrcode": "^1.5.4",
    "lucide-static": "^1.72.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.notchtasks.windows",
    "productName": "NotchTasks",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "l10n/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../mac/Resources/Sprites",
        "to": "Sprites"
      },
      {
        "from": "../mac/Sources",
        "to": "l10n",
        "filter": [
          "l10n-*.json"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "asarUnpack": [
      "src/core/*.ps1"
    ]
  }
}
