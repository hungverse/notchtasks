<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NotchTasks.Core\NotchTasks.Core.csproj" />
    <ProjectReference Include="..\..\src\NotchTasksHook\NotchTasksHook.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Runner log fixtures (Ci/RunnerLogsTests) are read from the output folder. -->
  <ItemGroup>
    <None Update="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The Swift-sealed crosscheck fixtures, originally sealed by the Swift crosscheck tool (Sync/BoxTests). -->
  <ItemGroup>
    <None Include="Fixtures\crosscheck\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The hook is not referenced as an assembly; copy its files next to the tests so HookExeTests can run it. -->
  <Target Name="CopyHookExe" AfterTargets="Build">
    <MSBuild Projects="..\..\src\NotchTasksHook\NotchTasksHook.csproj" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="HookTargetPath" />
    </MSBuild>
    <PropertyGroup>
      <HookOutDir>%(HookTargetPath.RootDir)%(HookTargetPath.Directory)</HookOutDir>
    </PropertyGroup>
    <ItemGroup>
      <HookFiles Include="$(HookOutDir)NotchTasksHook.exe;$(HookOutDir)NotchTasksHook.dll;$(HookOutDir)NotchTasksHook.deps.json;$(HookOutDir)NotchTasksHook.runtimeconfig.json" />
    </ItemGroup>
    <!-- a build off Windows makes no .exe: copy what exists -->
    <Copy SourceFiles="@(HookFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('%(HookFiles.Identity)')" />
  </Target>

</Project>
